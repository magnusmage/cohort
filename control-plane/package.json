{
  "name": "cohort-control-plane",
  "version": "0.1.0",
  "description": "Cohort control plane: a read-only, SSO-gated review and audit dashboard over a Cohort vault. The commercial layer; separate from the open-core vault, server, and CLI.",
  "license": "Apache-2.0",
  "author": "evdatsion",
  "private": true,
  "type": "module",
  "bin": {
    "cohort-control-plane": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .test-build/*.test.js",
    "audit": "npm audit --audit-level=high",
    "clean": "rm -rf dist .test-build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
