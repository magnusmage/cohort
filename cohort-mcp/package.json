{
  "name": "cohort-mcp",
  "version": "0.1.0",
  "description": "Cohort MCP server: the client-neutral engine behind the Cohort shared-memory vault.",
  "license": "Apache-2.0",
  "author": "evdatsion",
  "type": "module",
  "bin": {
    "cohort-mcp": "dist/index.js",
    "cohort": "dist/cli.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/server.js",
    "dist/server.d.ts",
    "dist/tools.js",
    "dist/tools.d.ts",
    "dist/git.js",
    "dist/git.d.ts",
    "dist/record.js",
    "dist/record.d.ts",
    "dist/policy.js",
    "dist/policy.d.ts",
    "dist/scan.js",
    "dist/scan.d.ts",
    "dist/lint.js",
    "dist/lint.d.ts",
    "dist/gate.js",
    "dist/gate.d.ts",
    "dist/load.js",
    "dist/load.d.ts",
    "dist/propose.js",
    "dist/propose.d.ts",
    "dist/status.js",
    "dist/status.d.ts",
    "dist/init.js",
    "dist/init.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/verify.js",
    "dist/verify.d.ts",
    "dist/capture.js",
    "dist/capture.d.ts",
    "dist/search.js",
    "dist/search.d.ts",
    "dist/stats.js",
    "dist/stats.d.ts",
    "dist/bridge.js",
    "dist/bridge.d.ts",
    "dist/reabsorb.js",
    "dist/reabsorb.d.ts",
    "dist/portable.js",
    "dist/portable.d.ts",
    "dist/indexer.js",
    "dist/indexer.d.ts",
    "dist/contradiction.js",
    "dist/contradiction.d.ts",
    "dist/staleness.js",
    "dist/staleness.d.ts",
    "dist/supersede.js",
    "dist/supersede.d.ts",
    "dist/merge.js",
    "dist/merge.d.ts",
    "dist/why.js",
    "dist/why.d.ts",
    "dist/access.js",
    "dist/access.d.ts",
    "dist/encryption.js",
    "dist/encryption.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .test-build/*.test.js",
    "audit": "npm audit --audit-level=high",
    "start": "node dist/index.js",
    "clean": "rm -rf dist .test-build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnusmage/cohort.git",
    "directory": "cohort-mcp"
  },
  "homepage": "https://github.com/magnusmage/cohort#readme",
  "bugs": {
    "url": "https://github.com/magnusmage/cohort/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cohort",
    "shared-memory"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "picomatch": "4.0.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@types/picomatch": "4.0.3",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
